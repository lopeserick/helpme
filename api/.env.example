# Copie para .env e ajuste conforme o seu ambiente.

# Banco de desenvolvimento. O usuário e o banco são criados no passo 2 do
# README; se você usou outra senha ou outra porta, ajuste aqui.
DATABASE_URL=postgres://helpme:helpme@localhost:5432/helpme

# Porta em que a API escuta. HOST=127.0.0.1 deixa a API acessível só pela
# própria máquina (recomendado em produção, atrás do IIS); padrão 0.0.0.0.
PORT=3000
# HOST=127.0.0.1

# Endereços do site e do painel autorizados a chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Código exigido na tela "Criar conta" do painel. Quem não souber o código não
# consegue criar conta. Troque por algo seu e só passe para quem vai editar.
# Sem esta linha, o cadastro fica desligado.
CODIGO_CADASTRO=troque-este-codigo

# Horas que a pessoa fica logada no painel
SESSAO_HORAS=12

# Em produção, com HTTPS, deixe COOKIE_SECURE=true. E, atrás do IIS (proxy
# reverso), TRUST_PROXY=true para o limite de tentativas ver o IP de verdade.
COOKIE_SECURE=false
TRUST_PROXY=false

# Pasta das imagens enviadas pelo painel. Vazio = a pasta "uploads" dentro de
# api/. Em produção use um caminho absoluto fora do código e faça backup dela.
# UPLOADS_DIR=D:\helpme\uploads

# --- Segurança do painel ----------------------------------------------------

# Endereço(s) do painel, separados por vírgula. Ações de escrita no painel só
# são aceitas vindas daqui. Em produção: https://painel.suaempresa.com.br
PAINEL_ORIGENS=http://localhost:5174

# Minutos parado até a sessão cair (além do limite de SESSAO_HORAS)
SESSAO_INATIVIDADE_MIN=30

# Tentativas de login, código e cadastro por minuto, vindas do mesmo IP
LIMITE_TENTATIVAS_IP=10

# Senhas erradas seguidas que bloqueiam a conta, e por quantos minutos
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_MIN=15

# Verificação em duas etapas (OPCIONAL, hoje desligada). Sem CHAVE_2FA, ela
# não aparece no painel e o login é só e-mail e senha. Para usar no futuro,
# CHAVE_2FA cifra os segredos no banco; gere com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e guarde num lugar seguro (trocá-la desliga a 2FA de todo mundo).
# Com EXIGIR_2FA=true (precisa da CHAVE_2FA), toda conta tem de ativar a 2FA.
CHAVE_2FA=
EXIGIR_2FA=false

# --- Sugestões dos clientes (página /sugestoes do site) -----------------------

# Para onde as sugestões vão. Sem esta linha, o formulário fica desligado.
SUGESTOES_DESTINO=sugestaobrasilsoftware@gmail.com

# Conta que ENVIA o e-mail. No Gmail, SMTP_SENHA é uma "senha de app" de 16
# letras (Conta Google > Segurança > Verificação em duas etapas > Senhas de
# app), nunca a senha normal da conta. Pode ser a mesma conta do destino.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_SEGURO=true
SMTP_USUARIO=sugestaobrasilsoftware@gmail.com
SMTP_SENHA=
SMTP_NOME_REMETENTE=Sugestões · Help Me

# Sugestões aceitas do mesmo IP a cada 15 minutos (contra spam)
LIMITE_SUGESTOES=5

# --- Integração com o Jira (AINDA DESLIGADA) -----------------------------------
# Tickets do Jira viram rascunhos em "O que há de novo". Para ligar, preencha
# as linhas abaixo e siga docs/jira.md (também é preciso descomentar a linha de
# sincronização em src/server.ts).
#
# Endereço do Jira Cloud
# JIRA_URL=https://suaempresa.atlassian.net
# Conta e token de API dessa conta (id.atlassian.com > Segurança > Tokens de API).
# Use uma conta só com permissão de LEITURA no projeto.
# JIRA_EMAIL=integracao@suaempresa.com.br
# JIRA_TOKEN=
# Quais tickets viram novidade (busca JQL)
# JIRA_JQL=project = ACS AND labels = novidade-site AND statusCategory = Done
# Campo do ticket com o texto para o cliente (ex.: customfield_10050). Vazio: usa a descrição.
# JIRA_CAMPO_TEXTO=
# Label do Jira = rótulo no site, separados por vírgula
# JIRA_ROTULOS=rotina-nova=Rotina nova,programa-novo=Programa novo,validacao-fiscal=Validação fiscal
# De quantos em quantos minutos buscar
# JIRA_INTERVALO_MIN=30
