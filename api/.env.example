# Copie para .env e ajuste conforme o seu ambiente.

# Banco de desenvolvimento. O usuário e o banco são criados no passo 2 do
# README; se você usou outra senha ou outra porta, ajuste aqui.
DATABASE_URL=postgres://helpme:helpme@localhost:5432/helpme

# Porta em que a API escuta
PORT=3000

# Endereços do site autorizados a chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Código exigido na tela "Criar conta" do painel. Quem não souber o código não
# consegue criar conta. Troque por algo seu e só passe para quem vai editar.
# Sem esta linha, o cadastro fica desligado.
CODIGO_CADASTRO=troque-este-codigo

# Horas que a pessoa fica logada no painel
SESSAO_HORAS=12

# Em produção, com HTTPS, deixe COOKIE_SECURE=true. E, atrás do IIS (proxy
# reverso), TRUST_PROXY=true para o limite de tentativas ver o IP de verdade.
COOKIE_SECURE=false
TRUST_PROXY=false

# Pasta das imagens enviadas pelo painel. Vazio = a pasta "uploads" dentro de
# api/. Em produção use um caminho absoluto fora do código e faça backup dela.
# UPLOADS_DIR=D:\helpme\uploads

# --- Segurança do painel ----------------------------------------------------

# Endereço(s) do painel, separados por vírgula. Ações de escrita no painel só
# são aceitas vindas daqui. Em produção: https://painel.suaempresa.com.br
PAINEL_ORIGENS=http://localhost:5174

# Minutos parado até a sessão cair (além do limite de SESSAO_HORAS)
SESSAO_INATIVIDADE_MIN=30

# Tentativas de login, código e cadastro por minuto, vindas do mesmo IP
LIMITE_TENTATIVAS_IP=10

# Senhas erradas seguidas que bloqueiam a conta, e por quantos minutos
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_MIN=15

# Verificação em duas etapas. CHAVE_2FA cifra os segredos no banco: gere com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e guarde num lugar seguro (trocá-la desliga a 2FA de todo mundo).
# Com EXIGIR_2FA=true, toda conta precisa ativar a 2FA para usar o painel.
CHAVE_2FA=
EXIGIR_2FA=false
